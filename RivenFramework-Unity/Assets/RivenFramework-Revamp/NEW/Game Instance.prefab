            fpsLimit:
              category: Audio/Audio Devices/Input Volume
              description: Controls how loud your microphone sounds to other players.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            masterVolume:
              category: Audio/Audio Mixer/Master
              description: Controls the volume for all sounds.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            musicVolume:
              category: Audio/Audio Mixer/Music
              description: Controls the volume for music.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            soundEffectsVolume:
              category: Audio/Audio Mixer/Sound Effects
              description: Controls the volume for all other sounds that don't fit
                in the other categories.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            voiceChatVolume:
              category: Audio/Audio Mixer/Voice Chat
              description: Controls the volume for how loud other players sound to
                you.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            characterChatterVolume:
              category: Audio/Audio Mixer/Character Chatter
              description: Controls the volume for in-game characters talking.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            ambienceVolume:
              category: Audio/Audio Mixer/Ambience
              description: Controls the volume for background environmental noises.
                (Eg. Crickets, ominous humming, flowing water)
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            menusVolume:
              category: Audio/Audio Mixer/Menus
              description: Controls the volume for anything in the user interface.
                (Eg. Button clicks, sliders, notifications)
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 50
              value: 0
            visualizeSoundEffects:
              category: Audio/Accessibility/Visualize Sound Effects
              description: When enabled, key sound effects will be shown as a symbol
                in a circular ring on the in-game HUD (Heads up display) indicating
                what direction a certain sound came from.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            closedCaptioning:
              category: Audio/Accessibility/Closed Captioning
              description: '-'
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            minVolumeDb:
              category: Audio/Accessibility/Min Volume (dB)
              description: '-'
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            maxVolumeDb:
              category: Audio/Accessibility/Max Volume (dB)
              description: '-'
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 140
              value: 0
            maxFrequencyKhz:
              category: Audio/Accessibility/Max Frequency (kHz)
              description: The maximum frequency that any game sounds can play, anything
                above this limit will be pitch shifted down to fall within this range.
                This is helpful if you can't, or don't want to hear higher pitch
                sounds.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 17
              value: 0
          gameplay:
            invertHorizontalLook:
              category: Gameplay/View/Invert Horizontal Look
              description: When enabled, looking left results in looking right, and
                looking right results in looking left.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            invertVerticalLook:
              category: Gameplay/View/Invert Vertical Look
              description: When enabled, looking up results in looking down, and
                looking down results in looking up.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            joystickLookSensitivity:
              category: Gameplay/View/Joystick Look Sensitivity
              description: How much the controller's joystick movement is multiplied
                by the look speed.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 6
              value: 0
            mouseLookSensitivity:
              category: Gameplay/View/Mouse Look Sensitivity
              description: How much the mouse movement is multiplied by the look
                speed.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 6
              value: 0
            horizontalLookSpeed:
              category: Gameplay/View/Horizontal Look Speed
              description: How quickly the player turns when looking left and right.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 6
              value: 0
            verticalLookSpeed:
              category: Gameplay/View/Vertical Look Speed
              description: How quickly the player turns when looking up and down.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 6
              value: 0
            fieldOfView:
              category: Gameplay/View/Field Of View
              description: 
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 80
              value: 0
            colorBlindIntensity:
              category: Gameplay/Accessibility/Color Blind Filter Intensity
              description: Adjusts the strength of the color blind filter by shifting
                the target color values for the active color blind filter further
                apart.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            colorBlindFilter:
              category: Gameplay/Accessibility/Color Blind Filter
              description: Shifts certain color values so they are more distinguishable
                from one another. This is intended to help people with color blindness,
                but can make parts of the game look distracting and unnatural. Protanopia
                reduces sensitivity to reds, Deuteranopia reduces sensitivity to
                greens, and Tritanopia reduces sensitivity to blues.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            colorBlindSymboling:
              category: Gameplay/Accessibility/Color Blind Symboling
              description: Attempts to add symbols, icons, and patterns to distinguish
                between gameplay elements that normally relly on color for identification.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            dyslexicFriendlyFont:
              category: Gameplay/Accessibility/Dyslexic Friendly Font
              description: When enabled, as many text elements as possible will have
                their fonts replaced with one that is easier to distinguish the difference
                between letters. Some text, such as on hand painted textures, will
                not be affected.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            reduceStrobingEffects:
              category: Gameplay/Accessibility/Reduce Strobing Effects
              description: Attempts to reduce sudden changes in visuals and light
                intensities, such as flickering effects or flashing lights. The post-processing
                method renders several frames ahead to try to detect and smoothly
                fade-in sudden changes in visuals. The hand-picked method is done
                by a developer manually marking certain effects as a 'flicker risk'
                and either replaces the effect or out right removes it.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            screenReader:
              category: Gameplay/Accessibility/Screen Reader
              description: Reads aloud the text in menus and user interfaces when
                hovering over them via a Text-To-Speech (TTS) voice.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
            textChatReader:
              category: Gameplay/Accessibility/Text Chat Reader
              description: Reads aloud the text chat in multiplayer games via a Text-To-Speech
                (TTS) voice.
              referenceImage: {fileID: 0}
              hidden: 0
              defaultValue: 0
              value: 0
