<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:GroupBox style="border-top-width: 1px; border-right-width: 2px; border-bottom-width: 3px; border-left-width: 1px; border-left-color: rgba(0, 0, 0, 0.78); border-right-color: rgba(0, 0, 0, 0.78); border-top-color: rgba(0, 0, 0, 0.78); border-bottom-color: rgba(0, 0, 0, 0.78); flex-shrink: 1; flex-grow: 0; width: auto; min-width: 97px; max-width: 100%; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgba(0, 0, 0, 0); padding-top: 0; padding-bottom: 0; padding-left: 0;">
        <ui:VisualElement name="ModuleHeader" style="flex-grow: 1; flex-direction: row; min-height: 24px; height: 24px; max-height: 24px; padding-left: 6px; margin-top: 0; background-color: rgba(0, 82, 255, 0.14); padding-top: 2px; padding-bottom: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Toggle value="false" name="Toggle_ModuleFoldout" class="unity-foldout__toggle" style="align-self: center; margin-left: 3px; margin-bottom: 3px; margin-right: 3px; margin-top: 3px;" />
                <ui:Label tabindex="-1" text="GameInstance Module Name" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label_ModuleName" style="-unity-font-style: bold; font-size: 14px; padding-left: 0; align-self: center; text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.53);" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; padding-right: 2px; padding-left: 2px;">
                <ui:VisualElement style="flex-grow: 1; align-self: center; border-bottom-width: 1px; border-right-width: 1px; border-left-color: rgba(0, 0, 0, 0.42); border-right-color: rgba(0, 0, 0, 0.42); border-top-color: rgba(0, 0, 0, 0.42); border-bottom-color: rgba(0, 0, 0, 0.42); margin-right: 2px; margin-left: 2px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Button text="-" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; width: auto; height: 20px; align-self: center; min-height: 20px; max-height: 20px; min-width: 20px; font-size: 16px; -unity-text-align: middle-center; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.68);" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; align-self: center; border-bottom-width: 1px; border-right-width: 1px; border-left-color: rgba(0, 0, 0, 0.42); border-right-color: rgba(0, 0, 0, 0.42); border-top-color: rgba(0, 0, 0, 0.42); border-bottom-color: rgba(0, 0, 0, 0.42); margin-right: 2px; margin-left: 2px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Button text="?" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; width: auto; height: 20px; align-self: center; min-height: 20px; max-height: 20px; min-width: 20px; font-size: 16px; -unity-text-align: middle-center; -unity-font-style: bold; text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.68);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FoldoutContent" style="flex-grow: 1;">
            <ui:VisualElement style="flex-grow: 0; height: 2px; max-height: 2px; min-height: 2px; background-color: rgba(0, 0, 0, 0.79);" />
            <ui:VisualElement style="flex-grow: 1; background-color: rgba(53, 53, 53, 0);">
                <ui:VisualElement name="PropertyValues" style="flex-grow: 0; flex-shrink: 0; padding-right: 4px; padding-left: 4px; padding-bottom: 6px; padding-top: 6px; margin-left: 8px; background-color: rgba(0, 0, 0, 0); margin-right: 8px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
